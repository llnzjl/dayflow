# ---- Provider switches: mock | real implementation ----
MAP_PROVIDER=mock            # mock | naver
PLACE_PROVIDER=mock          # mock | naver
TRANSIT_PROVIDER=mock        # mock | korean
WEATHER_PROVIDER=mock        # mock | openmeteo (no key needed)
PRAYER_PROVIDER=mock         # mock | aladhan (no key needed)

# ---- NAVER Cloud Platform (Maps: geocode / directions) ----
NAVER_NCP_KEY_ID=
NAVER_NCP_KEY=
# ---- NAVER Developers (Local Search for places) ----
NAVER_SEARCH_CLIENT_ID=
NAVER_SEARCH_CLIENT_SECRET=
# ---- Browser map (NAVER Dynamic Map JS). Leave empty to use the built-in SVG map ----
NEXT_PUBLIC_NAVER_MAP_CLIENT_ID=

# ---- Korean public transit (data.go.kr / TAGO) ----
TAGO_SERVICE_KEY=
SEOUL_OPEN_DATA_KEY=

# ---- AI (optional: without it a rule-based intent parser is used) ----
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ---- Server: database, security, admin ----
DATABASE_FILE=./data/dateflow.db      # SQLite file (created automatically)
APP_SECRET=                           # 32+ random chars; encrypts dietary/religious profile data. Dev: auto-generated in ./data
ADMIN_EMAILS=                         # comma-separated emails that get /admin access
COOKIE_SECURE=0                       # set 1 behind HTTPS in production
RESERVATION_PROVIDER=mock             # mock | none

# ---- Email (password reset). Without SMTP_URL the link is only shown in dev / server log ----
SMTP_URL=                             # e.g. smtps://user:app-password@smtp.gmail.com:465
MAIL_FROM=DateFlow <no-reply@yourdomain.com>
APP_URL=http://localhost:3000         # public base URL used in email links
